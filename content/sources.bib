@misc{wp-persian-language,
  author = {{Wikipedia contributors}},
  title = {Persian language},
  howpublished = {English Wikipedia},
  url = {https://en.wikipedia.org/wiki/Persian_language},
  urldate = {2026-11-10},
  note = {Read the first 100,000 of about 280,000 characters. Checked: three mutually intelligible standards (Iranian Persian, Dari, Tajik); Old, Middle, New Persian as one language (Lazard); oldest Old Persian inscription Behistun; Middle Persian official, religious and literary language of the Sasanian empire (Lazard 1975), Aramaic-derived Pahlavi and Manichaean scripts; New Persian texts in Arabic script from the 9th century; emergence from the Ctesiphon court dialect and Khorasan (Paul 2000; Perry 2011); subperiods Early (8th/9th c.), Classical (10th to 18th c.), Contemporary (19th c. on); Mughal sole official language, gradual replacement from 1843; heavy medieval borrowing from Arabic; influence on Turkic, Armenian, Georgian, Greek, Indo-Aryan (Holes 2001); Persian loanwords in Hindi-Urdu, Punjabi, Kashmiri, Bengali, Sindhi; the page gives Dari official both "since 1964" and "since 1958" in different sections. Tertiary source; replace with Encyclopaedia Iranica "Persian language i. Early New Persian" (Paul) and related entries. Text CC BY-SA 4.0; nothing copied.}
}

@misc{wp-middle-persian,
  author = {{Wikipedia contributors}},
  title = {Middle Persian},
  howpublished = {English Wikipedia},
  url = {https://en.wikipedia.org/wiki/Middle_Persian},
  urldate = {2026-11-10},
  note = {Checked: Sasanian period 224-651; loss of almost all case inflection, rise of prepositions; loss of word-final unstressed syllables (martiya- > mard); heterograms (LY read man, GBRA read mard); Inscriptional Pahlavi, Book Pahlavi, Manichaean script ("regular and unambiguous"), Psalter Pahlavi; section Samples: Kartir KZ 1, transliteration "W ANE kltyl ZY mgwpt...", transcription "ud az Kirdīr ī mowbed...", translation "And I, Kartir, the Magus priest, have been of good service". Tertiary source; replace with Iranica or MacKenzie 1971. Text CC BY-SA 4.0; one short phrase quoted.}
}

@misc{wp-persian-phonology,
  author = {{Wikipedia contributors}},
  title = {Persian phonology},
  howpublished = {English Wikipedia},
  url = {https://en.wikipedia.org/wiki/Persian_phonology},
  urldate = {2026-11-10},
  note = {Read the first 100,000 characters. Checked: Iranian vowels /æ e o/ and /ɒː iː uː/ (Toosarvandani 2004; Majidi and Ternes 1999); length no longer distinctive; q and ɣ merged as [ɢ], [ɣ] or [ʁ] between vowels (Thackston 1993; Jahani 2005); glottal stop before initial vowels; accent on the last stem syllable of most words, negative prefix accented (Windfuhr 1997 and others); single-consonant onsets, epenthesis in loans (Mahootian 1997; Jahani 2005); Early New Persian eight vowels (Rees 2008); Dari keeps them (Rastorgueva 1982); Tajik mergers; Classical /w/ > [v] in Iranian and Tajik, kept in Dari (Baker 2016 and others). Tertiary source; replace with Majidi and Ternes, JIPA 1991, after access. Text CC BY-SA 4.0; nothing copied.}
}

