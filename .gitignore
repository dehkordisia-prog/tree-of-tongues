node_modules/
dist/
# Only the web app's build output; pipeline/build/ is source code.
apps/*/build/
.react-router/
.lighthouseci/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.env
.env.*
data/raw/*
data/build/
.claude/settings.local.json
playwright-report/
test-results/
.DS_Store

# Third-party reference images stay local (the repo is public)
reference/*
!reference/README.md

# Han font slices are fetched at build by scripts/fetch-fonts.mjs (D-015); the stylesheet and OFL stay.
apps/web/public/fonts/noto-sans-sc/*.woff2

# Raw download manifest is committed; its contents (data/raw/<source>/) are not.
!data/raw/MANIFEST.yaml

# Playwright MCP session artifacts
.playwright-mcp/
